# ──────────────────────────────────────────────
# Finance AI Backend — Production environment
# ──────────────────────────────────────────────
# Copy to /opt/finance-ai/.env on the VM after setup.
# Replace ALL placeholders with real values.
# ──────────────────────────────────────────────

FINANCE_AI_ENVIRONMENT=production
FINANCE_AI_DATABASE_URL=postgresql+psycopg://finance_ai:<DB_PASSWORD>@localhost:5432/finance_ai
FINANCE_AI_LOG_LEVEL=INFO
FINANCE_AI_SESSION_LIMITER_SECRET=<run: openssl rand -hex 32>
FINANCE_AI_ACCESS_LIFETIME_MINUTES=15
FINANCE_AI_RENEWABLE_IDLE_LIFETIME_DAYS=30
FINANCE_AI_SESSION_ABSOLUTE_LIFETIME_DAYS=90
FINANCE_AI_MAX_ACTIVE_SESSIONS_PER_USER=10
FINANCE_AI_TERMINAL_SESSION_RETENTION_DAYS=30
FINANCE_AI_MAX_REQUEST_BODY_BYTES=16384
FINANCE_AI_REGISTRATION_PER_MINUTE=10
FINANCE_AI_REGISTRATION_BURST_PER_10_SECONDS=3
FINANCE_AI_LOGIN_PER_MINUTE=10
FINANCE_AI_LOGIN_BURST_PER_10_SECONDS=5
FINANCE_AI_UNSAFE_PASSWORDS_PATH=/opt/finance-ai/unsafe-passwords.txt
# ──────────────────────────────────────────────
# AI provider (see docs/STACK.md)
# Placeholders only — never commit real keys.
# ──────────────────────────────────────────────
FINANCE_AI_LLM_PROVIDER=gemini
FINANCE_AI_GEMINI_API_KEY=<Google AI Studio key>
FINANCE_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FINANCE_AI_GEMINI_MODEL=gemini-3.8-flash
FINANCE_AI_DEEPSEEK_API_KEY=<DeepSeek platform key>
FINANCE_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
FINANCE_AI_DEEPSEEK_MODEL=deepseek-flash
FINANCE_AI_LLM_TIMEOUT_SECONDS=30
FINANCE_AI_LLM_MAX_OUTPUT_TOKENS=2048
FINANCE_AI_LLM_MAX_IMAGE_BYTES=1048576
