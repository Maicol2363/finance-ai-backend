{% extends "base.html.j2" %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td style="background-color:{{ banner_background }};border-radius:8px;padding:12px 14px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:1.4;color:{{ banner_color }};">{{ headline }}</td>
</tr>
</table>
<p class="tx" style="margin:18px 0 2px 0;font-size:17px;font-weight:600;color:#202b28;">{{ budget_name }}</p>
<p class="tx-muted" style="margin:0 0 14px 0;font-size:13px;color:#5c6a66;">{{ period_label }}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 6px 0;">
<tr>
<td class="line" style="background-color:#e1e8e5;border-radius:6px;height:12px;line-height:12px;font-size:0;">
<table role="presentation" width="{{ bar_width }}%" cellpadding="0" cellspacing="0" border="0">
<tr><td style="background-color:{{ bar_color }};border-radius:6px;height:12px;line-height:12px;font-size:0;">&nbsp;</td></tr>
</table>
</td>
</tr>
</table>
<p class="tx-muted" style="margin:0 0 14px 0;font-size:13px;color:#5c6a66;">Has usado el <strong class="c-{{ tone }}" style="color:{{ banner_color }};">{{ percent_text }}</strong> de tu presupuesto.</p>
{% if show_amounts %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 18px 0;">
<tr>
<td width="33%" style="vertical-align:top;"><span class="tx-muted" style="font-size:12px;color:#5c6a66;">Gastado</span><br><span class="tx" style="font-size:16px;font-weight:600;color:#202b28;">{{ spent_text }}</span></td>
<td width="33%" style="vertical-align:top;"><span class="tx-muted" style="font-size:12px;color:#5c6a66;">Límite</span><br><span class="tx" style="font-size:16px;font-weight:600;color:#202b28;">{{ limit_text }}</span></td>
<td width="34%" style="vertical-align:top;"><span class="tx-muted" style="font-size:12px;color:#5c6a66;">{{ remaining_label }}</span><br><span class="{{ remaining_class }}" style="font-size:16px;font-weight:600;color:{{ remaining_color }};">{{ remaining_text }}</span></td>
</tr>
</table>
{% endif %}
<p class="tx" style="margin:0 0 8px 0;font-size:14px;color:#202b28;">Abre Finance AI y entra a <strong>Presupuestos</strong> para ver el detalle.</p>
{% endblock %}
