FINANCE_AI_ENVIRONMENT=local
FINANCE_AI_DATABASE_URL=postgresql+psycopg://finance_ai:change-me-local@localhost:55432/finance_ai
# Explicit local Vite origins; no cookies are enabled for browser clients.
FINANCE_AI_CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
FINANCE_AI_LOG_LEVEL=INFO
FINANCE_AI_REGISTRATION_PER_MINUTE=10
FINANCE_AI_REGISTRATION_BURST_PER_10_SECONDS=3
FINANCE_AI_REGISTRATION_GLOBAL_PER_MINUTE=100
FINANCE_AI_LOGIN_PER_MINUTE=10
FINANCE_AI_LOGIN_BURST_PER_10_SECONDS=5
FINANCE_AI_LOGIN_ACCOUNT_PER_MINUTE=5
FINANCE_AI_LOGIN_GLOBAL_PER_MINUTE=300
FINANCE_AI_REFRESH_PER_MINUTE=30
FINANCE_AI_REFRESH_GLOBAL_PER_MINUTE=1000
FINANCE_AI_SESSION_LIMITER_SECRET=change-me-local-session-limiter
FINANCE_AI_ACCESS_LIFETIME_MINUTES=15
FINANCE_AI_RENEWABLE_IDLE_LIFETIME_DAYS=30
FINANCE_AI_SESSION_ABSOLUTE_LIFETIME_DAYS=90
FINANCE_AI_MAX_ACTIVE_SESSIONS_PER_USER=10
FINANCE_AI_TERMINAL_SESSION_RETENTION_DAYS=30

# --- AI provider ("gemini" | "deepseek"); HU-013 text capture uses it too ---
FINANCE_AI_LLM_PROVIDER=gemini

# --- Gemini (OpenAI-compatible endpoint) ---
FINANCE_AI_GEMINI_API_KEY=change-me-gemini-api-key
FINANCE_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FINANCE_AI_GEMINI_MODEL=gemini-3.8-flash

# --- DeepSeek (OpenAI-compatible) ---
FINANCE_AI_DEEPSEEK_API_KEY=change-me-deepseek-api-key
FINANCE_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
FINANCE_AI_DEEPSEEK_MODEL=deepseek-flash

# --- Shared LLM tuning ---
FINANCE_AI_LLM_TIMEOUT_SECONDS=30
FINANCE_AI_LLM_MAX_OUTPUT_TOKENS=2048
FINANCE_AI_LLM_MAX_IMAGE_BYTES=1048576

# --- Staff security: SEC-01 TOTP for security_auditor and AUD-01..04 bounds ---
# 32 random bytes encoded with base64url, supplied by deployment configuration. Empty keeps
# Security Auditor sign-in disabled (fails closed). Generate one with:
#   uv run python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FINANCE_AI_STAFF_MFA_ENCRYPTION_KEY=
# Administrator sessions are shorter than other staff sessions (SEC-01) and invitations expire (ADM-03).
FINANCE_AI_STAFF_ADMIN_ACCESS_MINUTES=10
FINANCE_AI_STAFF_ADMIN_IDLE_MINUTES=15
FINANCE_AI_STAFF_ADMIN_ABSOLUTE_HOURS=4
FINANCE_AI_STAFF_INVITATION_HOURS=48
FINANCE_AI_AUDIT_MAX_QUERY_DAYS=90
FINANCE_AI_AUDIT_MAX_REPORT_EVENTS=2000

# --- Email notifications (EML-01) ---
# console writes each email under FINANCE_AI_EMAIL_CONSOLE_DIRECTORY (.eml and a browsable .html) and
# never delivers anything: use it for development and previews. smtp delivers through a sandbox inbox
# or a provider; the SMTP password belongs in a secret manager, never in the repository. Nothing here
# is required to start the API; without a real sender notifications report that they are unavailable.
FINANCE_AI_EMAIL_PROVIDER=console
FINANCE_AI_EMAIL_FROM_ADDRESS=
FINANCE_AI_EMAIL_FROM_NAME=Finance AI
FINANCE_AI_EMAIL_REPLY_TO=
FINANCE_AI_EMAIL_CONSOLE_DIRECTORY=var/email-preview
FINANCE_AI_EMAIL_SMTP_HOST=
FINANCE_AI_EMAIL_SMTP_PORT=587
FINANCE_AI_EMAIL_SMTP_USERNAME=
FINANCE_AI_EMAIL_SMTP_PASSWORD=
# starttls, ssl or none (none is refused in production)
FINANCE_AI_EMAIL_SMTP_SECURITY=starttls
FINANCE_AI_EMAIL_SMTP_TIMEOUT_SECONDS=10
# Public origin of this API (https outside local development, no trailing slash): used only for the
# unsubscribe link inside emails.
FINANCE_AI_PUBLIC_BASE_URL=
# Shared secret (at least 32 characters) for POST /internal/notifications/dispatch, which a scheduler
# calls every minute. Empty keeps the endpoint disabled.
FINANCE_AI_NOTIFICATION_DISPATCH_TOKEN=
FINANCE_AI_EMAIL_DAILY_CAP_PER_USER=10
FINANCE_AI_EMAIL_MAX_ATTEMPTS=5
FINANCE_AI_EMAIL_VERIFICATION_MINUTES=15
FINANCE_AI_EMAIL_VERIFICATION_MAX_ATTEMPTS=5

